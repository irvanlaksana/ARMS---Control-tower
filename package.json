{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview --port 5173",
    "preview:prod": "npm run build && npm run start",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "validate:creds": "node scripts/validate-google-creds.mjs",
    "db:columns": "node scripts/generate-supabase-columns.mjs",
    "db:validate": "node scripts/generate-supabase-columns.mjs && node scripts/validate-supabase-schema.mjs",
    "db:validate:data": "node scripts/validate-arms-data.mjs",
    "db:setup": "node scripts/setup-supabase.mjs",
    "db:schema": "node scripts/setup-supabase.mjs --schema-only",
    "db:seed": "node scripts/setup-supabase.mjs --seed-only",
    "spreadsheet:setup": "node scripts/sync-spreadsheet.mjs",
    "supabase:link": "npx supabase link",
    "supabase:push": "npx supabase db push"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.115.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.17.1",
    "googleapis": "^174.0.1",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "serverless-http": "^4.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@vercel/node": "^5.9.9",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}

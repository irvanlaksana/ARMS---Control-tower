# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firestore named database used by the ARMS application.
# Set the same value in Vercel if the deployment uses a different Firebase project.
VITE_FIRESTORE_DATABASE_ID="ai-studio-armsptmitrajasat-52aae9e1-5f32-4716-863f-a8a1a969eef9"

# Google Sheets & Drive (Service Account).
# Set SALAH SATU dari dua variabel di bawah agar /api/sheets/* dan /api/drive/* berfungsi:
#   - GOOGLE_SERVICE_ACCOUNT_JSON: isi penuh JSON service account (disarankan utk Vercel/Cloud Run)
#   - GOOGLE_APPLICATION_CREDENTIALS: path ke file JSON service account (utk VPS/lokal)
#     Path relatif dihitung dari folder root repo (process.cwd()), mis. "./service-account.json"
#     = file service-account.json di folder root repo. File ini TIDAK boleh di-commit.
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"

# Alternatif paling tahan banting (opsional): JSON service account dalam base64.
# Menghindari kerusakan `\n` pada private_key saat ditempel ke secret manager.
# Buat nilainya dengan:  base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=""

# Validasi kredensial setelah mengisi env di atas:
#   node scripts/validate-google-creds.mjs
#   node scripts/validate-google-creds.mjs <SPREADSHEET_ID>   # sekaligus uji akses spreadsheet

# SUPABASE CONFIGURATION:
# Digunakan untuk integrasi database Supabase dan auto-setup tabel.
# Ambil dari: Supabase Dashboard -> Project Settings -> API & Database
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# GITHUB_TOKEN: Diperlukan agar tombol "Buat Issue Generator" (repo generate-surat-tugas) berfungsi.
GITHUB_TOKEN=""

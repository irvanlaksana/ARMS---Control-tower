# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# 1. DATABASE UTAMA: SUPABASE
# ==============================================================================
# Dapatkan dari Supabase Dashboard: Project Settings -> API
# - Project URL:
VITE_SUPABASE_URL=""
# - Project API Keys (anon public key):
VITE_SUPABASE_ANON_KEY=""

# ==============================================================================
# 2. PENYIMPANAN FOTO JPG & DOKUMEN: GOOGLE DRIVE
# ==============================================================================
# Dapatkan dari Google Cloud Console -> IAM & Admin -> Service Accounts.
# Buat Service Account, buat Key jenis JSON, lalu salin isi file JSON ke variabel ini:
GOOGLE_SERVICE_ACCOUNT_JSON=""

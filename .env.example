# ==============================================================================
# ARMS — Control Tower | Environment Variables
# Deployment target: NETLIFY  |  Database: GOOGLE CLOUD FIRESTORE
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# 1. DATABASE UTAMA: GOOGLE CLOUD FIRESTORE (Firebase)
# ==============================================================================
# Konfigurasi web app Firebase (public) SUDAH tersisip di
# firebase-applet-config.json — tidak perlu env var.
#
# Opsional: nama database Firestore selain "(default)".
# (Hanya perlu diisi bila memakai custom database.)
# VITE_FIRESTORE_DATABASE_ID="(default)"

# Project ID Firebase (untuk info; default terbaca dari firebase-applet-config.json)
FIREBASE_PROJECT_ID="gen-lang-client-0940128449"

# ==============================================================================
# 2. KREDENSIAL SERVER (Netlify Functions / server lokal)
# ==============================================================================
# SATU Service Account dari project Firebase yang SAMA (project_id di atas)
# dipakai untuk:
#   - Google Drive  (folder & upload dokumen: KTP, SPPI, SKP, BAST, dll)
#   - Google Sheets (ekspor laporan database — opsional)
#   - Skrip migrasi/seed Firestore (npm run db:setup, db:validate:firestore)
#
# Cara set di NETLIFY: Site settings → Environment variables →
#   nama: GOOGLE_SERVICE_ACCOUNT_JSON
#   nilai: SELURUH isi file JSON service account (satu baris, JSON valid;
#          baris baru di private_key harus \n)
#
# Lokal (.env):
# GOOGLE_SERVICE_ACCOUNT_JSON='{\"type\":\"service_account\",\"project_id\":\"...\",\"private_key\":\"...\",\"client_email\":\"...\"}'
#
# Alternatif lokal: path ke file JSON
# GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"
GOOGLE_SERVICE_ACCOUNT_JSON=""

# ==============================================================================
# 3. OPSIONAL — modul Surat (Sinkron GitHub issue generate-surat-tugas)
# ==============================================================================
# GITHUB_TOKEN: personal access token dengan scope `repo`
# GITHUB_TOKEN=""
# SURAT_REPO_OWNER="irvanlaksana"
# SURAT_REPO_NAME="generate-surat-tugas"
# GENERATOR_SURAT_BASE_URL="https://generator-surat-new.vercel.app"

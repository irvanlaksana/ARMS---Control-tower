# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# 1. DATABASE UTAMA: SUPABASE
# ==============================================================================
# Dapatkan dari Supabase Dashboard: Project Settings -> API
# - Project URL:
VITE_SUPABASE_URL=""
# - Project API Keys (anon public key):
VITE_SUPABASE_ANON_KEY=""

# ==============================================================================
# 2. PENYIMPANAN FOTO JPG & DOKUMEN: GOOGLE DRIVE
# ==============================================================================
# Dapatkan dari Google Cloud Console -> IAM & Admin -> Service Accounts.
# Buat Service Account, buat Key jenis JSON, lalu salin isi file JSON ke variabel ini:
GOOGLE_SERVICE_ACCOUNT_JSON=""

# ==============================================================================
# 3. DEPLOY GOOGLE APPS SCRIPT (spreadsheet aktif) — disarankan
# ==============================================================================
# URL Web App Apps Script (berakhiran /exec). Diisi bila aplikasi di-host
# terpisah dari Apps Script (mode GAS_URL) — dapat juga diisi lewat UI:
# Settings -> Pengaturan Sistem & Google Sheets -> "URL Web App Google Apps Script".
VITE_GAS_WEB_APP_URL=""

# Bila diisi, server.ts/Netlify/Vercel meneruskan seluruh /api/* ke Apps Script
# (mode hybrid: hosting lama tetap dipakai, penyimpanan di spreadsheet aktif).
GAS_WEB_APP_URL=""

# Catatan: pada deploy Apps Script, GOOGLE_SERVICE_ACCOUNT_JSON TIDAK diperlukan —
# Drive diakses lewat DriveApp sebagai akun deploy, dan token GitHub disimpan di
# Script Properties (GITHUB_TOKEN) atau key `githubToken` pada tab Settings.

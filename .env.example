# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# 1. DATABASE UTAMA: SUPABASE
# ==============================================================================
# Dapatkan dari Supabase Dashboard: Project Settings -> API
# - Project URL:
VITE_SUPABASE_URL=""
# - Project API Keys (anon public key):
VITE_SUPABASE_ANON_KEY=""

# ==============================================================================
# 2. PENYIMPANAN FOTO JPG & DOKUMEN: GOOGLE DRIVE
# ==============================================================================
# Dapatkan dari Google Cloud Console -> IAM & Admin -> Service Accounts.
# Buat Service Account, buat Key jenis JSON, lalu salin isi file JSON ke variabel ini:
GOOGLE_SERVICE_ACCOUNT_JSON=""

# (Alternatif untuk VPS/Lokal) path ke file JSON service account, mis. ./service-account.json
GOOGLE_APPLICATION_CREDENTIALS=""

# (Opsional) Scope OAuth Drive. Default: https://www.googleapis.com/auth/drive (penuh),
# dibutuhkan bila folder master dibuat MANUAL lalu di-share ke service account.
# Isi "https://www.googleapis.com/auth/drive.file" hanya jika folder master juga
# dibuat oleh aplikasi ini (least privilege); kalau tidak, pembuatan folder akan 404.
# GOOGLE_DRIVE_SCOPES="https://www.googleapis.com/auth/drive"

# (Opsional) ID project Google Cloud, dipakai di pesan diagnosis.
# GOOGLE_PROJECT_ID="arms-control-tower"

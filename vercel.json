{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/gas/proxy",
      "destination": "/api/gas/proxy"
    },
    {
      "source": "/api/sheets/setup",
      "destination": "/api/sheets/setup"
    },
    {
      "source": "/api/sheets/sync",
      "destination": "/api/sheets/sync"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
